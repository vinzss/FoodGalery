# Salin file ini menjadi server/.env lalu sesuaikan.

# --- MySQL (XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foodalbum_db

# --- API ---
API_PORT=4000
# Ganti dengan string acak panjang (min. 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# --- Admin pertama (hanya dipakai saat belum ada admin di database) ---
SEED_ADMIN_USERNAME=calvin
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_EMAIL=calvin@foodalbum.local
